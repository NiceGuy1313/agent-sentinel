    <ADDITIONAL>\\n    \",\"cache_control\":{\"type\":\"ephemeral\"}}],\"tools\":[{\"name\":\"computer\",\"type\":\"computer_20250124\",\"display_width_px\":1024,\"display_height_px\":768,\"display_number\":1},{\"type\":\"bash_20250124\",\"name\":\"bash\"},{\"name\":\"str_replace_based_edit_tool\",\"type\":\"text_editor_20250728\"}]}"}
